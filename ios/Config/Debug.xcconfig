// Local Docker stack (compose.yaml). The Simulator reaches the Mac's localhost directly.
// xcconfig treats // as a comment, so the URL is split with $().
SUPABASE_URL = http:/$()/localhost:54321
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6ImV4cGVyaWVuY2UtbG9jYWwiLCJpYXQiOjE3NjAwMDAwMDAsImV4cCI6MjI0MDAwMDAwMH0.q95zZrpDTV16yQ5rgAooYQPzmX5ZCE_Ps3Th8xGS1RI
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG LOCAL_BACKEND

// On a real iPhone, "localhost" is the phone. Create ios/Config/Local.xcconfig (gitignored) with your Mac's address:
//   SUPABASE_URL = http:/$()/192.168.1.20:54321
//   DEVELOPMENT_TEAM = ABCDE12345
#include? "Local.xcconfig"
