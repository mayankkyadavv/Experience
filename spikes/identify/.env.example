# Copy to .env (gitignored) and fill in. Everything is optional: with nothing set,
# the decoder runs fully locally (Ollama + OpenStreetMap).

# Claude for the "understand" step: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# YouTube Data API v3 key: adds descriptions + tags without downloading anything.
YOUTUBE_API_KEY=

# Apple Maps Server API "Maps auth token" (needs an Apple Developer account).
# Without it, place search uses OpenStreetMap Nominatim.
APPLE_MAPS_AUTH_TOKEN=

# Local overrides
# OLLAMA_HOST=http://127.0.0.1:11434
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin
# PORT=4321
