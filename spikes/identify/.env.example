# Copy to .env (gitignored) and fill in.

# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: adds YouTube descriptions + tags (YouTube Data API v3 key from Google Cloud console).
# Without it, YouTube gives the title only.
YOUTUBE_API_KEY=

# Optional: Apple Maps Server API "Maps auth token" (needs an Apple Developer account).
# Without it, place search uses OpenStreetMap Nominatim.
APPLE_MAPS_AUTH_TOKEN=
